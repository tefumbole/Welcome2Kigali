# Welcome 2 Kigali API — dedicated port (VPS: 3008). Never 3004 (Beyond) or 3003 (AlphaBridge).
PORT=3008
NODE_ENV=production
CORS_ORIGIN=https://welcome2kigali.com
APP_URL=https://welcome2kigali.com
JWT_SECRET=change_this_to_a_long_random_string
COMPANY_NAME=Welcome 2 Kigali Expats Club

# Dedicated welcome2kigali MySQL — never reuse beyondtech_laravel / alphabridge
# Homebrew local: 3306  |  Docker: 3308 after `docker compose up -d`
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=w2k
DB_PASSWORD=your_mysql_password
DB_NAME=welcome2kigali_api

WASENDER_API_KEY=
WASENDER_BASE_URL=https://wasenderapi.com/api
WASENDER_DEFAULT_COUNTRY=RW

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SEED_ADMIN_EMAIL=admin@welcome2kigali.com
SEED_ADMIN_PASSWORD=ChangeMe@123456

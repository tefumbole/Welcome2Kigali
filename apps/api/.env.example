# Welcome 2 Kigali API — use a dedicated database, never Beyond's Hostinger DB
PORT=3003
NODE_ENV=production
CORS_ORIGIN=https://welcome2kigali.com
APP_URL=https://welcome2kigali.com
JWT_SECRET=change_this_to_a_long_random_string

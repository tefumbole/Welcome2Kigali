# Copy to apps/api/.env for local offline development.
# Isolated Welcome 2 Kigali MySQL — never copy Beyond production credentials.
PORT=3003
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
JWT_SECRET=local_dev_jwt_secret_change_in_production
COMPANY_NAME=Welcome 2 Kigali Expats Club

# Isolated welcome2kigali DB (Homebrew :3306, or Docker :3308 after `docker compose up -d`)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=w2k
DB_PASSWORD=w2k_local
DB_NAME=welcome2kigali_api

SEED_ADMIN_EMAIL=admin@welcome2kigali.local
SEED_ADMIN_PASSWORD=ChangeMe@123456

UPLOAD_DIR=./uploads

# Copy WASENDER_API_KEY only if you have a Welcome 2 Kigali Wasender account
WASENDER_API_KEY=
WASENDER_BASE_URL=https://wasenderapi.com/api
WASENDER_DEFAULT_COUNTRY=RW
WASENDER_MIN_SEND_INTERVAL_MS=6000
WASENDER_TEXT_TO_DOCUMENT_DELAY_MS=6000

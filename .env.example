# Supabase (legacy — only if VITE_DATA_BACKEND is not mysql)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Data backend: "mysql" = local API (offline-capable). Omit or "supabase" for cloud.
VITE_DATA_BACKEND=mysql
VITE_API_URL=/api

# Skip OTP step in local dev (WhatsApp needs internet)
VITE_DEV_SKIP_OTP=true

# Branding — Welcome 2 Kigali Expats Club
VITE_COMPANY_NAME=Welcome 2 Kigali Expats Club
VITE_COMPANY_NAME_SHORT=Welcome 2 Kigali
VITE_SITE_URL=https://welcome2kigali.com
VITE_WEBSITE_HOST=www.welcome2kigali.com
VITE_CONTACT_EMAIL=hello@welcome2kigali.com
VITE_LOGO_URL=/branding/w2k-logo.png
VITE_HERO_IMAGE_URL=/branding/w2k-logo.png

# Payment
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key
VITE_MOBILE_MONEY_API_KEY=your_mobile_money_key

# WasenderAPI
VITE_WASENDER_API_KEY=your_wasender_api_key
VITE_WASENDER_BASE_URL=https://wasenderapi.com/api
VITE_DEFAULT_PHONE_COUNTRY=RW
VITE_WASENDER_PHONE=

# Admin Security
VITE_ADMIN_EMAIL=admin@welcome2kigali.com
VITE_ADMIN_PHONE_NUMBER=

# SMTP Configuration
VITE_SMTP_HOST=smtp.example.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=otp@example.com
VITE_SMTP_PASS=your_smtp_password
VITE_SMTP_FROM=otp@example.com

#!/usr/bin/env bash
# Auto-increment the app version on every commit.
# Source of truth: laravel-app/VERSION (semver x.y.z), read by App\Support\AppVersion.
#
# Scheme (W2K_V_x.y.z):
#   1.1.9 → 1.1.10 → 1.2.1
#   after 1.10.10 → 2.2.1
#
# Skip once with:  SKIP_VERSION_BUMP=1 git commit ...
set -euo pipefail

[ "${SKIP_VERSION_BUMP:-0}" = "1" ] && exit 0

ROOT="$(git rev-parse --show-toplevel)"
FILE="$ROOT/laravel-app/VERSION"
[ -f "$FILE" ] || exit 0

current="$(tr -d '[:space:]' < "$FILE")"
case "$current" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) exit 0 ;;  # not a semver we understand — leave it alone
esac

major="${current%%.*}"
rest="${current#*.}"
minor="${rest%%.*}"
patch="${rest#*.}"

patch=$((patch + 1))
if [ "$patch" -gt 10 ]; then
  patch=1
  minor=$((minor + 1))
fi
if [ "$minor" -gt 10 ]; then
  minor=2
  major=$((major + 1))
fi

next="${major}.${minor}.${patch}"

printf '%s\n' "$next" > "$FILE"
git add "$FILE"

ERP="W2K_V_${next}"
for js in "$ROOT/src/constants/appVersion.js" "$ROOT/apps/api/src/constants/appVersion.js"; do
  [ -f "$js" ] || continue
  if grep -q "export const APP_VERSION" "$js"; then
    sed -i '' "s/export const APP_VERSION = 'W2K_V_[^']*';/export const APP_VERSION = '${ERP}';/" "$js" 2>/dev/null \
      || sed -i "s/export const APP_VERSION = 'W2K_V_[^']*';/export const APP_VERSION = '${ERP}';/" "$js"
    git add "$js"
  fi
done

echo "[pre-commit] version bumped: $current -> $next"

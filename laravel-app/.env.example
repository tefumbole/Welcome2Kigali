APP_NAME="Welcome 2 Kigali Expats Club"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION="W2K V.1.0.0"

# Beyond portal: skip WhatsApp OTP at login (LOCAL ONLY — keep false in production)
BEYOND_SKIP_OTP=false

LOG_CHANNEL=stack

# Isolated Welcome 2 Kigali MySQL — never point at beyondtech_laravel / alphabridge.
# Homebrew: port 3306, database welcome2kigali, user w2k
# Docker:   docker compose up -d  (host port 3308)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=welcome2kigali
DB_USERNAME=w2k
DB_PASSWORD=w2k_local

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Messaging channels (Settings → Messaging Settings)
MESSAGING_WHATSAPP_ENABLED=true
MESSAGING_SMS_ENABLED=true

# WhatsApp provider: WASENDER | TWILIO
# WASENDER = all WhatsApp texts/OTP/announcements/documents (default).
# TWILIO WhatsApp Content Templates are optional; Twilio Account SID/Token/Number are still used for SMS.
WHATSAPP_SERVICE=WASENDER
WHATSAPP_DEFAULT_COUNTRY_CODE=250
WHATSAPP_TWILIO_FALLBACK_WASENDER=true
COMPANY_NAME="Welcome 2 Kigali Expats Club"

# WasenderAPI (WhatsApp)
WASENDER_API_KEY=
WASENDER_SESSION_ID=
WASENDER_BASE_URL=https://wasenderapi.com/api
WASENDER_MIN_SEND_INTERVAL_MS=6000
WASENDER_TEXT_TO_DOCUMENT_DELAY_MS=6000

# Optional Twilio WhatsApp Content Templates (only when WHATSAPP_SERVICE=TWILIO)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID_ADMISSION=HX47150e179fdbab79738d060fb0ac6415
TWILIO_WHATSAPP_CONTENT_SID_STATUS=HX47150e179fdbab79738d060fb0ac6415
TWILIO_WHATSAPP_CONTENT_SID_OTP=

# SMS gateway: twilio | clickatell (independent of WhatsApp provider)
SMS_GATEWAY=twilio
ACCOUNT_SID=
AUTH_TOKEN=
TWILIO_NUMBER=
CLICKATELL_API_KEY=

# Legacy aliases still supported by config/services.php:
# WASENDER_API_URL=https://wasenderapi.com/api
# WHATSAPP_SEND_INTERVAL=6
# Twilio_Number=  (legacy; prefer TWILIO_NUMBER)

# PawaPay mobile money (MTN MoMo / Airtel). Token stays in .env — never commit it.
PAWAPAY_ENVIRONMENT=production
PAWAPAY_API_TOKEN=
PAWAPAY_API_TOKEN_ID=
PAWAPAY_LIVE_BASE_URL=https://api.pawapay.io
PAWAPAY_SANDBOX_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_DEPOSIT_CALLBACK_URL="${APP_URL}/api/payments/pawapay/deposits/callback"
PAWAPAY_CHECKOUT_CALLBACK_URL="${APP_URL}/api/payments/pawapay/checkouts/callback"
PAWAPAY_PAYOUT_CALLBACK_URL="${APP_URL}/api/payments/pawapay/payouts/callback"
PAWAPAY_REFUND_CALLBACK_URL="${APP_URL}/api/payments/pawapay/refunds/callback"

# Stripe Visa (test mode uses 4242 4242 4242 4242, any CVC, any future date)
STRIPE_MODE=test
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_LIVE_KEY=
STRIPE_LIVE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=rwf

# Optional Node/React invitations store — same isolated local DB if used
BEYOND_DATA_DB_HOST=127.0.0.1
BEYOND_DATA_DB_PORT=3306
BEYOND_DATA_DB_DATABASE=welcome2kigali
BEYOND_DATA_DB_USERNAME=w2k
BEYOND_DATA_DB_PASSWORD=w2k_local
